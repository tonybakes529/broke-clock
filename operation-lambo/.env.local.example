# Supabase project URL, e.g. https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Never expose to the browser.
# Used by the nightly slip cron to evaluate every user.
SUPABASE_SERVICE_ROLE=

# Shared secret to protect the /api/slip cron endpoint.
# Vercel Cron sends this automatically if you set CRON_SECRET in project env.
CRON_SECRET=
